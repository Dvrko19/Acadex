DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=

PORT=
FRONTEND_URL=
JWT_SECRET=
APP_TIMEZONE=UTC

MAX_SUBMISSION_FILE_SIZE_MB=25
FILE_STORAGE_PROVIDER=local
PRIVATE_UPLOAD_DIRECTORY=./private-uploads
# Produccion con Cloudflare R2. Mantener el bucket privado.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

API_RATE_LIMIT=600
LOGIN_RATE_LIMIT=10
# Primera version: validacion simulada. No realiza analisis antivirus.
FILE_SCAN_PROVIDER=mock
MOCK_FILE_SCAN_RESULT=clean
MOCK_FILE_SCAN_DELAY_MS=400
# Segunda version: usar FILE_SCAN_PROVIDER=clamav y configurar el daemon.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
